# הדאטהסט עצמו כבד (‏~25MB) ומשוחזר ביט-אחר-ביט מ-gen_dataset.js · לגיט נכנס
# manifest.json בלבד, שנושא את ה-SHA-256 של כל קובץ ואת הזרע שהפיק אותו.
# הריפו הזה ציבורי · ראה CLAUDE.md.
*.jsonl

# יוצא דופן אחד · טבלת הזהב. היא אינה דאטהסט אלא **ארטיפקט השקילות** בין המעבדה
# לריצה: tests/71 מריצה אותה מחדש על הפונקציה המורמת מ-app.js, ואי-התאמה אחת היא
# אדום. אם היא לא בגיט, הבדיקה הזאת אינה קיימת אצל אף אחד חוץ ממי שהריץ evolve.
# ‏2.2MB, ‏10,002 החלטות, דטרמיניסטית (אומת: שתי ריצות מפיקות קובץ זהה ביט-אחר-ביט).
!golden.jsonl

# מטמון בלבד · coverage.js בונה אותו מחדש מ-buildCrossCard (‏432 שניות) והוא נמחק
# אוטומטית כשה-sha של הדאטהסט משתנה. ‏574KB של נגזרת · אין סיבה שייכנס לריפו ציבורי.
coverage-cross.json

# נגזרות כבדות · כל אחת משוחזרת בפקודה אחת מהקוד שבגיט, וכל אחת היא מאות KB עד
# מגה בריפו **ציבורי**. הדוח המקביל (‏*-report.md) כן נכנס, כי הוא מה שקוראים.
budget-sweep.json
enbank-coverage.json
coverage.json
coverage-uncovered.json
gloss-search.json

# אוצר המילים שנכרה מהפירושים · ‏1.2MB, נגזר מ-data.js על ידי mine_gloss_vocab.js.
# ⚠ הוא **קלט** לבניית לקסיקון הריצה (‏lib/lexicon.js FILES), ולכן היעדרו מהגיט
# פוגע בשחזור הלקסיקון. ראה STATE · הנכס הנשלח ממילא אינו משוחזר מהבנאי היום.
gloss-vocab.json

# מועמדים · נוצרים ב-make_candidate.js/promote_candidate.js מתוך shortword.json.
# שני יוצאי הדופן למטה הם אלה ש**שער המאגר רץ עליהם בפועל**, ובלעדיהם אי אפשר
# לשחזר לא את הירוק ולא את הוכחת השיניים.
*-candidate-rules.json
graded-minlen3-rules.json
RED-teeth-rules.json
typo-rules.*.json
!typo-rules.CANDIDATE.json
!typo-rules.REDGRADED.json
!typo-rules.HE-CANDIDATE.json
!typo-rules.HE-REDGRADED.json
!typo-rules.SUB2.json

# ‏he-cross.json · הקבוצה חוצת-הכרטיסים שנבנתה מחדש (614 שניות) אחרי שהתגלה
# ש-coverage-cross.json מעופש. ‏560KB נגזרת, ומסונן מאותה סיבה בדיוק.
he-cross.json

# עותקי דאטהסט ישנים · v1-old/ ו-v2/ הם גיבויים מקומיים של ריצות קודמות.
v1-old/
v2/

# דאמפים של סבב המורפולוגיה · עד 1MB כל אחד, כולם משוחזרים מ-morph_veto_search.js
# ומ-measure_morph.js. הדוחות (‏morph-*-report.md) כן נכנסים — הם מה שקוראים.
morph-residual.*.json
morph-veto-search.json
morph-dump.*.json
morph-cases-gate.log

# ===== סבב העברית · 15.8 =====
# מאגר המועמדים · 884KB נגזרת, נבנה מחדש ב-`node typo-lab/he_morph_split.js --pool`
# ‏(‏~90 שניות) מתוך data.js. אין בו מידע שאינו משוחזר, והריפו ציבורי.
morph-pool.json

# אצוות הקלט לשופטים · נגזרות מ-morph-pool.json בפקודה אחת (`--emit`, `--emit-pos`,
# `--emit-blind`, `he_verb_gate --emit`). ‏180KB שאין סיבה לשמור.
panel/batch-*.tsv
panel/pos-[0-9]*.tsv
panel/vg-[0-9]*.tsv

# ⚠ הפסקים עצמם (`panel/*verdict*.tsv`, ‏83KB) **כן** נכנסים, וזו הכרעה ולא שכחה:
# הם פלט של שופטי-LLM ולכן **אינם משוחזרים ביט-אחר-ביט**. בלעדיהם אי אפשר לשחזר
# לא את הכיול, לא שיעורי שימור-המשמעות, ולא את פסק שער חלק-הדיבר · כלומר כל
# המדידה של הסבב הזה הופכת לטענה בלי ראיה. אותו שיקול חל על
# `semantic-blind.labeled.tsv` — 40 התיוגים של חגי הם ה-ground truth היחיד כאן
# ואין דרך לייצר אותם מחדש.

# דאמפים כבדים מסבב טעויות ההקלדה בעברית · משוחזרים מ-he_mater_closed.js
# ומ-he_delta_residue.js. ריפו ציבורי · הדוחות כן נכנסים, הדאמפים לא.
he-mater-closed.*.json
he-delta.*.json

# ===== המורה · teacher.js =====
# ⭐ הפנקסים והסטים **כן** נכנסים לגיט, ולכן חריגה מפורשת מ-`*.jsonl` למעלה.
# הם 88KB בסך הכול, והם **העדות עצמה**: 371 פסקי-שופט שעלו כסף וזמן להפיק.
# בלעדיהם `--calib` מדווח "אין פסקים · המורה אינו עדות עד שיכויל", וכל מי
# שימשוך את הריפו יצטרך לשלם שוב על אותה מדידה בדיוק. זו אותה הצדקה שבגללה
# `golden.jsonl` הוא חריג למעלה: ארטיפקט השקילות אינו דאטהסט.
!teacher/calib.jsonl
!teacher/neg24.jsonl
!teacher/ledger.calib.jsonl
!teacher/ledger.neg24.jsonl

# אצוות הקלט · נגזרות ב-`--emit` בשנייה אחת מ-teacher/<set>.jsonl. אין סיבה
# שיהיו בריפו ציבורי.
teacher/batch/

# פלט גולמי של השופטים · **מיותר**, לא "כבד". כל שורה בו כבר נקלטה לפנקס
# (‏key · פסק · נימוק), ו-`--ingest` הוא חד-כיווני מכאן לשם. הפנקס הוא מקור
# האמת, והקבצים האלה הם רק תחנת ביניים.
# ⚠ יוצא הדופן `verdict/retired/` נשמר מחוץ למסלול הקליטה בכוונה: ‏T1 פרשה
# אחרי שנמדדה כחותמת גומי, והשער ב-`ingest` **זורק** על פסק חדש לעדשה שפרשה.
teacher/verdict/

# ===== קורפוס התשובות · gen_answers.js · 16.8 =====
# ‏115,881 שורות ב-4 קבצים · **60MB** בסך הכול (‏answers-he 11.8MB · answers-en
# ‏20.8MB · answers-dx-he 8.6MB · answers-dx-en 19.0MB). הריפו ציבורי, וכולם
# משוחזרים ביט-אחר-ביט בפקודה אחת: `node typo-lab/gen_answers.js` · ‏175 שניות.
# אומת בפועל · שלוש הרצות עצמאיות מפיקות את אותם חמישה SHA-256 בדיוק.
# הם כבר נתפסים ב-`*.jsonl` למעלה; הבלוק הזה קיים כדי שהנימוק יהיה כתוב ולא מוסק,
# ומפני ש-`!golden.jsonl` מוכיח שהחריגים כאן מפורשים ולא מקריים.
answers-he.jsonl
answers-en.jsonl
answers-dx-he.jsonl
answers-dx-en.jsonl
answers-cases24.jsonl

# ⚠ שני קבצים **כן** נכנסים לגיט, וזו הכרעה ולא שכחה:
#   `answers-manifest.json`  · הזרע, הפרמטרים שמולם נמדדה רצועת הגבול, ה-SHA-256
#                              של כל קובץ, טבלת ההתפלגות המלאה ושערי הדליפה.
#                              בלעדיו אי אפשר לדעת אם הקורפוס שאצלך הוא זה שנמדד.
#   `answers-report.md`      · זה מה שקוראים · אותה מדיניות של שאר ה-*-report.md.
# שניהם קטנים (‏<100KB) ואינם מכילים שום נתון אישי · ראה CLAUDE.md.

# ===== התלמיד · features.js / fit.js / loop.js · 16.8 =====
# ‏out/cache/ · **188MB**. מטמון התכונות: כל שורה בשני הדאטהסטים + הקבוצה
# חוצת-הכרטיסים, פרושה לווקטורי תכונות. הריפו ציבורי, וזו נגזרת טהורה שנבנית
# בפקודה אחת: `node --max-old-space-size=6144 typo-lab/build_features.js`
# (‏1,015 שניות · מהן ~970 ב-buildCrossCard). אין בו מידע שאינו נמצא בדאטהסטים.
# ‏`cache/manifest.json` נושא את ה-SHA של הדאטהסטים ושל features.js, והוא היחיד
# שהיה שווה לשמור — אבל גם הוא חסר ערך בלי הקבצים שהוא מתאר, ולכן הכול בחוץ.
cache/

# ארטיפקטי המדידה של התלמיד · `student-*.json`. אלה **כן** נכנסים (70-80KB כל
# אחד): הם נושאים את המודל עצמו, את פילוח ה-recall לפי אורך, את השארית ואת
# עקומת הלמידה — כלומר את המספרים שההמלצה נשענת עליהם. בלעדיהם ההמלצה היא טענה
# בלי ראיה, וזו בדיוק אותה הצדקה של `golden.jsonl` ושל פנקסי המורה למעלה.

# ===== התור למורה · teacher_queue.js · 16.8 =====
# ‏112,742 פריטים · **30MB** · נגזרת מלאה של הקורפוס + `probe-ours.json`, ומשוחזרת
# בפקודה אחת: `node typo-lab/teacher_queue.js` (‏שניות ספורות · אין קריאות מודל).
# דטרמיניסטי · אומת בשער ט, שתי בניות מפיקות את אותו SHA-256.
teacher-queue.jsonl

# ⚠ ו**שלושה** קבצים כן נכנסים, וזו הכרעה:
#   `teacher-queue.md`  · טבלת נקודות העצירה · זה מה שמכריעים לפיו כמה לשלם
#   `probe-accepts.md`  · פילוח exact/typo, סעיף חציית הכרטיסים, particleMatch
#   `probe-ours.json`   · ‏186 המזהים שהאפליקציה החיה מקבלת דרך השכבה שלנו.
#     ‏10KB, והוא **קלט** ל-teacher_queue (מדרגת T0). בלעדיו בניית התור דורשת
#     הרצה של 4 דקות מול app.js, ו-T0 מתרוקן בשקט. נכנס בכוונה.

# שני סטי הכיול שנוספו · אותה הצדקה כמו למעלה — הם העדות, והם קטנים.
# `*-blind.tsv` הם הקלט העיוור · `*.labeled.tsv` הם התיוג האנושי · `*.design.json`
# הוא רישום הכוונה של כל שורה (⛔ אסור לשלוח אותו לשופט או למתייג).
# שלושתם אינם jsonl ולכן אינם נתפסים בכלל הגורף למעלה — נרשמים כאן לתיעוד בלבד.
!teacher/nearneg24.jsonl
!teacher/en40.jsonl
!teacher/ledger.nearneg24.jsonl
!teacher/ledger.en40.jsonl
